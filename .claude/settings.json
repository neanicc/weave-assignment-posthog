{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret set*)",
      "Bash(gh auth token --show*)",
      "Bash(vercel --prod*)"
    ]
  }
}
