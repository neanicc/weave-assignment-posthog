{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret set*)",
      "Bash(vercel --prod*)",
      "Bash(git push *+*)",
      "Bash(git push * main*)",
      "Bash(git push * *:main*)",
      "Bash(git -c *)",
      "Bash(git --*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status -t*)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh api *pulls/*/merge*)"
    ]
  }
}
